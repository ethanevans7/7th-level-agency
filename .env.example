# Final HTTPS origin. Redeploy after changing these values.
NEXT_PUBLIC_SITE_URL=http://localhost:3007
# false for previews; true only for the public production deployment.
SITE_INDEXABLE=false
# Create a form at https://formspree.io and copy only the ID from /f/YOUR_ID.
# Configure and verify the receiving inbox in Formspree, then test delivery.
FORMSPREE_FORM_ID=
# Optional HTTPS consultation booking link.
SCHEDULING_URL=
# Optional analytics; leave blank until ready to enable.
NEXT_PUBLIC_GA_ID=
